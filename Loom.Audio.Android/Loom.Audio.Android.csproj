<Project Sdk="Microsoft.NET.Sdk">
	<!-- Android's audio output: Loom.Audio's device seam filled by AAudio (AndroidAudio.Register). Kept out of Loom.slnx,
	     in Loom.Android.slnx, so the desktop build never needs the android workload. -->
	<PropertyGroup>
		<TargetFramework>net11.0-android</TargetFramework>
		<!-- Android 10, as Loom.Hosting.Android; AAudio itself is there from Android 8 -->
		<SupportedOSPlatformVersion>29</SupportedOSPlatformVersion>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<AllowUnsafeBlocks>true</AllowUnsafeBlocks>
	</PropertyGroup>
	<PropertyGroup Label="NuGet">
		<PackageId>Loom.Audio.Android</PackageId>
		<Description>The Android audio output for Loom.Audio, through AAudio: a low-latency stream on the default output, reopened when the output changes.</Description>
		<PackageTags>audio;android;aaudio;gamedev;dotnet</PackageTags>
		<GenerateDocumentationFile>true</GenerateDocumentationFile>
	</PropertyGroup>
	<!-- The AAudio callback shim (Native/loom_aaudio.c), prebuilt per ABI by Native/build.ps1 so building needs no NDK.
	     Packed into the library, and so into every app that references it. -->
	<ItemGroup>
		<AndroidNativeLibrary Include="Native\lib\arm64-v8a\libloomaaudio.so" Abi="arm64-v8a" />
		<AndroidNativeLibrary Include="Native\lib\x86_64\libloomaaudio.so" Abi="x86_64" />
	</ItemGroup>
	<ItemGroup>
		<ProjectReference Include="..\Loom.Audio\Loom.Audio.csproj" />
	</ItemGroup>
</Project>

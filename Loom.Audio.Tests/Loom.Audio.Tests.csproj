<Project Sdk="Microsoft.NET.Sdk">

  <!-- The audio's tests: the mixer, decoders and outputs (Loom.Audio, Loom.Audio.Sdl), synthesis and music
       (Loom.Audio.Synth), and the music generator. Nothing of the engine's: what these test needs no window or GPU. -->
  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <!-- TUnit runs on Microsoft.Testing.Platform, whose source generator emits the executable entry point. -->
    <OutputType>Exe</OutputType>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="TUnit" />
    <PackageReference Include="Shouldly" />
    <!-- Compiles the C# that PatchCode writes, to check it builds the patch it was written from -->
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="TUnit.Core" />
    <Using Include="Shouldly" />
  </ItemGroup>

  <!-- The decoders' files, copied beside the test assembly -->
  <ItemGroup>
    <Content Include="AudioFixtures\*.ogg;AudioFixtures\*.s16;AudioFixtures\*.flac" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Loom.Audio.Synth\Loom.Audio.Synth.csproj" />
    <ProjectReference Include="..\Loom.Audio.Sdl\Loom.Audio.Sdl.csproj" />
    <!-- Driven in-process by MusicGeneratorTests, as a library rather than as this project's analyzer -->
    <ProjectReference Include="..\Loom.Audio.Music.Generator\Loom.Audio.Music.Generator.csproj" />
    <!-- The sample music project, whose generated music is checked against its files -->
    <ProjectReference Include="..\samples\HelloSynth\HelloSynth.csproj" />
  </ItemGroup>

</Project>

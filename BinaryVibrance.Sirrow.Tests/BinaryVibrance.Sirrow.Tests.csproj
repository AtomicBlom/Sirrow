<Project Sdk="Microsoft.NET.Sdk">

  <!-- Sirrow's tests: the mixer, decoders and outputs (BinaryVibrance.Sirrow, .Sdl), its effects and building blocks,
       and rendering offline. Nothing of an engine's: what these test needs no window or GPU. -->
  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <!-- TUnit runs on Microsoft.Testing.Platform, whose source generator emits the executable entry point. -->
    <OutputType>Exe</OutputType>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="TUnit" />
    <PackageReference Include="Shouldly" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="TUnit.Core" />
    <Using Include="Shouldly" />
  </ItemGroup>

  <!-- The decoders' files, copied beside the test assembly -->
  <ItemGroup>
    <Content Include="AudioFixtures\*.ogg;AudioFixtures\*.s16;AudioFixtures\*.flac" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\BinaryVibrance.Sirrow\BinaryVibrance.Sirrow.csproj" />
    <ProjectReference Include="..\BinaryVibrance.Sirrow.Sdl\BinaryVibrance.Sirrow.Sdl.csproj" />
  </ItemGroup>

</Project>

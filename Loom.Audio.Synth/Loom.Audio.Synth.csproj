<Project Sdk="Microsoft.NET.Sdk">
	<!-- Software synthesis over Loom.Audio: DSP building blocks, effects, a fixed-voice synthesizer chip with patches as
	     data, and music written as code (scales, notation, songs, a sequencer). Depends only on Loom.Audio and the BCL. -->
	<PropertyGroup>
		<TargetFramework>net11.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<IsAotCompatible>true</IsAotCompatible>
	</PropertyGroup>
	<PropertyGroup Label="NuGet">
		<PackageId>Loom.Audio.Synth</PackageId>
		<Description>Software synthesis for Loom: DSP building blocks, effects, a 16-operator synthesizer chip with patches as data, sampled drum kits, and music written as code.</Description>
		<PackageTags>audio;synthesis;fm;music;sequencer;gamedev;dotnet</PackageTags>
		<GenerateDocumentationFile>true</GenerateDocumentationFile>
	</PropertyGroup>
	<ItemGroup>
		<InternalsVisibleTo Include="Loom.Audio.Tests" />
		<InternalsVisibleTo Include="Loom.Audio.Workbench.Tests" />
	</ItemGroup>
	<ItemGroup>
		<ProjectReference Include="..\Loom.Audio\Loom.Audio.csproj" />
	</ItemGroup>
	<!-- The music generator, packed as this package's analyzer, so a project writing music for the chip (its patch and song
	     files) gets it with the package; build/Loom.Audio.Synth.props makes visible the properties it reads. Built first,
	     never referenced: it is a netstandard2.0 analyzer, no part of this assembly. -->
	<ItemGroup>
		<ProjectReference Include="..\Loom.Audio.Music.Generator\Loom.Audio.Music.Generator.csproj" ReferenceOutputAssembly="false" PrivateAssets="all" />
		<None Include="..\Loom.Audio.Music.Generator\bin\$(Configuration)\netstandard2.0\Loom.Audio.Music.Generator.dll" Pack="true" PackagePath="analyzers\dotnet\cs" Visible="false" />
		<None Include="build\Loom.Audio.Synth.props" Pack="true" PackagePath="build" />
	</ItemGroup>
</Project>

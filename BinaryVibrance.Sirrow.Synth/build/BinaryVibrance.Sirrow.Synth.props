<Project>

  <!--
    Imported into a project that takes the BinaryVibrance.Sirrow.Synth package, which carries the music generator as its analyzer
    (analyzers/dotnet/cs): the MSBuild properties the generator reads, made visible to it. The project says which music
    files it has, as AdditionalFiles:

      <AdditionalFiles Include="Patches\*.patch.json;Songs\*.song.json" />

    docs/synth.md, "Music as data", has the rest. A project building Sirrow from source references the generator itself
    (OutputItemType="Analyzer") and declares these the same way.
  -->
  <ItemGroup>
    <!-- The generated code's namespace, and a song's under it by its folder below the project -->
    <CompilerVisibleProperty Include="RootNamespace" />
    <CompilerVisibleProperty Include="ProjectDir" />
    <!-- The classes a project's patches, kits, cues and macros are found in, where not Patches, Kits, Cues, Macros -->
    <CompilerVisibleProperty Include="SirrowMusicPatches" />
    <CompilerVisibleProperty Include="SirrowMusicKits" />
    <CompilerVisibleProperty Include="SirrowMusicCues" />
    <CompilerVisibleProperty Include="SirrowMusicMacros" />
  </ItemGroup>

</Project>

{
  "format": "sirrow-patch/1",
  "name": "picked bass",
  "about": "A picked bass: a sine with a little feedback, a bright pick at the start of each note.",
  "operators": [
    { "name": "pick", "kind": "sine", "ratio": 3, "envelope": "decay 0.06", "level": 0.8, "velocity": 0.7 },
    {
      "name": "body",
      "kind": "sine",
      "envelope": "adsr 0.002 0.9 0.3 0.08",
      "feedback": 0.15,
      "modulatedBy": [{ "op": "pick", "index": 2 }]
    }
  ],
  "out": [{ "op": "body" }],
  "drive": 0.2,
  "mono": {}
}

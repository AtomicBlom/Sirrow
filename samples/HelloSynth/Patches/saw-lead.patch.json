{
  "format": "sirrow-patch/1",
  "name": "saw lead",
  "about": "A saw lead whose filter the Bright macro opens. Each saw starts at a different place in its cycle: two starting together are one loud wave, a click.",
  "operators": [
    { "name": "saw", "kind": "saw", "envelope": "adsr 0.01 0.4 0.7 0.15", "level": 0.5 },
    { "name": "detuned", "kind": "saw", "detune": 9, "phase": 0.37, "envelope": "adsr 0.01 0.4 0.7 0.15", "level": 0.5 }
  ],
  "out": [{ "op": "saw" }, { "op": "detuned" }],
  "filter": { "kind": "lowPass", "cutoff": 900, "q": 1.2, "envelopeOctaves": 1, "envelope": "decay 0.5" },
  "sends": { "echo": 0.15 },
  "vibrato": { "rate": 5, "depth": 0.1, "delay": 0.3 },
  "macros": [{ "macro": 0, "target": "filterCutoff", "from": 0.5, "to": 3 }]
}

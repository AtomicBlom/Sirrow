{
  "format": "loom-song/1",
  "name": "demo",
  "about": "The demo song: two sections over the same groove, a bass over the chords, a lead that comes in with the intensity, and a motif per mood that comes in only where its phrase starts.",
  "tempo": 112,
  "scale": "A minor",
  "tracks": [
    { "name": "drums", "kit": "demo-kit", "humanise": { "ms": 4, "velocity": 0.08 } },
    { "name": "bass", "patch": "picked-bass", "octave": 2 },
    { "name": "keys", "patch": "electric-piano", "level": -4 },
    {
      "name": "lead",
      "patch": "saw-lead",
      "octave": 5,
      "level": -6,
      "macros": [{ "macro": "bright", "follow": "intensity", "from": 0.1, "to": 1 }]
    },
    { "name": "motif", "patch": "pluck", "octave": 5, "level": -3 }
  ],
  "sections": [
    {
      "name": "verse",
      "bars": 4,
      "chords": "i | VI | III | VII",
      "parts": [
        {
          "track": "drums",
          "beat": "eighths",
          "rows": {
            "kick": "x... ..x. x... ....",
            "snare": "..x. ..x. ..x. ..xo",
            "hat-closed": "xxxx xxx. xxxx xxx.",
            "hat-open": ".... ...x .... ...x"
          },
          "endWith": { "beat": "sixteenths", "rows": { "snare": "..x. x.x. xxxx XXXX", "kick": "x... .... x... ...." } }
        },
        { "track": "bass", "line": "eighths", "notes": "1 . 1 1 5, . 1 . | 1 . 1 1 7, . 5, .", "overChords": true },
        { "track": "keys", "line": "quarters", "notes": "1 3 5 3", "overChords": true },
        {
          "track": "lead",
          "line": "eighths",
          "notes": "5 - 3 5 7 - 5 3 | 4 - 2 4 6 - 4 2 | 3 - 1 3 5 - 3 1 | 2 - 7, 2 4 - 2 7,",
          "when": "intensity > 0.5"
        },
        {
          "track": "motif",
          "name": "calm motif",
          "line": "quarters",
          "notes": "1 - 3 - | 5 - 3 - | 1 - 2 - | 3 - - -",
          "when": "mood is Calm",
          "onPhrase": true
        },
        {
          "track": "motif",
          "name": "bright motif",
          "line": "eighths",
          "notes": "5 6 8 6 5 3 5 - | 6 8 9 8 6 5 3 - | 5 6 8 6 5 3 2 3 | 1 - - - . . . .",
          "when": "mood is Bright",
          "onPhrase": true
        },
        {
          "track": "motif",
          "name": "dark motif",
          "line": "quarters",
          "notes": "1 b2 1 . | 7, - 5, . | 1 b2 3 b2 | 1 - - .",
          "when": "mood is Dark",
          "onPhrase": true
        }
      ]
    },
    {
      "name": "chorus",
      "bars": 4,
      "chords": "VI VII | i | VI VII | i",
      "parts": [
        {
          "track": "drums",
          "beat": "eighths",
          "rows": { "kick": "x.x. x.x.", "snare": "..X. ..X.", "hat-open": "x.x. x.x." }
        },
        { "track": "bass", "line": "eighths", "notes": "1 - 1 - 1 1 5, 1", "overChords": true },
        { "track": "keys", "line": "eighths", "notes": "1 3 5 8 5 3 1 3", "overChords": true },
        {
          "track": "lead",
          "line": "quarters",
          "notes": "8 - 7 5 | 8 - - - | 8 - 9 7 | 8 - - -",
          "when": "intensity > 0.5"
        }
      ]
    }
  ],
  "order": ["verse", "verse", "chorus"]
}

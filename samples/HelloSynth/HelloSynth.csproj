<Project Sdk="Microsoft.NET.Sdk">

	<!--
		A music project to start from, and the one loom-workbench's "new" makes: a song, four patches and a kit, written in
		the workbench and played from it with nothing else: open it with loom-workbench, as README.md says. Its song and
		patches are files (Songs/*.song.json, Patches/*.patch.json) that Loom's music generator makes into C# as it builds;
		what a file can't say (the kit, the cues, the catalog) is C# here.
	-->
	<PropertyGroup>
		<TargetFramework>net11.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<RootNamespace>HelloSynth</RootNamespace>
	</PropertyGroup>

	<ItemGroup>
		<ProjectReference Include="..\..\Loom.Audio.Synth\Loom.Audio.Synth.csproj" />
	</ItemGroup>

	<!-- The music as data: the generator makes C# of each file as the project builds -->
	<ItemGroup>
		<AdditionalFiles Include="Patches\*.patch.json;Songs\*.song.json" />
		<CompilerVisibleProperty Include="RootNamespace" />
		<CompilerVisibleProperty Include="ProjectDir" />
		<ProjectReference Include="..\..\Loom.Audio.Music.Generator\Loom.Audio.Music.Generator.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
	</ItemGroup>

</Project>

<Project Sdk="Microsoft.NET.Sdk">
	<!-- The desktop's audio output: Loom.Audio's device seam filled by SDL 3 (SdlAudio.Register). SDL3.dll comes from the
	     BinaryVibrance.Kaldra.SDL3 package, which carries SDL's own Windows builds and nothing else, so this needs no
	     engine and no window: any app with a desktop entry point can play through it. -->
	<PropertyGroup>
		<TargetFramework>net11.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<AllowUnsafeBlocks>true</AllowUnsafeBlocks>
		<IsAotCompatible>true</IsAotCompatible>
	</PropertyGroup>
	<PropertyGroup Label="NuGet">
		<PackageId>Loom.Audio.Sdl</PackageId>
		<Description>The desktop audio output for Loom.Audio, through SDL 3: the system's default playback device at the lowest latency it takes.</Description>
		<PackageTags>audio;sdl;gamedev;dotnet</PackageTags>
		<GenerateDocumentationFile>true</GenerateDocumentationFile>
	</PropertyGroup>
	<ItemGroup>
		<ProjectReference Include="..\Loom.Audio\Loom.Audio.csproj" />
		<PackageReference Include="BinaryVibrance.Kaldra.SDL3" />
	</ItemGroup>
	<ItemGroup>
		<InternalsVisibleTo Include="Loom.Tests" />
	</ItemGroup>
</Project>
